<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GODDY RECRUIT - Quản Lý Hóa Đơn, Công Nợ & Tuyển Dụng</title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --sidebar-bg: #0f172a;
      --card-bg: #ffffff;
      --border-color: #e2e8f0;
      --text-main: #1e293b;
      --text-muted: #64748b;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
    body { background-color: #f8fafc; color: var(--text-main); display: flex; min-height: 100vh; }

    /* SIDEBAR */
    .sidebar {
      width: 270px;
      background: var(--sidebar-bg);
      color: #fff;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.05);
    }
    .sidebar-header {
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .sidebar-logo-icon {
      width: 42px; height: 42px;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; color: #fff;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }
    .sidebar-title { font-weight: 800; font-size: 18px; letter-spacing: -0.5px; }
    .sidebar-subtitle { font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: 600; }
    .sidebar-menu { list-style: none; padding: 20px 14px; flex: 1; margin: 0; }
    .sidebar-item {
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 6px;
      cursor: pointer;
      display: flex; align-items: center; gap: 14px;
      color: #94a3b8; font-weight: 500; font-size: 14px;
      transition: all 0.2s ease;
    }
    .sidebar-item:hover { background: rgba(255,255,255,0.06); color: #fff; transform: translateX(3px); }
    .sidebar-item.active { background: var(--primary); color: #fff; font-weight: 600; box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35); }
    .sidebar-footer { padding: 18px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 12px; color: #64748b; }

    /* MAIN CONTENT */
    .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }
    .top-navbar {
      height: 70px; background: #fff; border-bottom: 1px solid var(--border-color);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px;
    }
    .page-title { font-size: 20px; font-weight: 700; margin: 0; letter-spacing: -0.3px; }
    .user-pill {
      display: flex; align-items: center; gap: 10px;
      background: #f1f5f9; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600;
    }

    .content-container { padding: 28px 32px; flex: 1; }

    /* METRIC CARDS */
    .metric-card {
      background: #fff;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 22px;
      display: flex; justify-content: space-between; align-items: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .metric-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.05); }
    .metric-title { font-size: 13px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
    .metric-value { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }
    .metric-icon-box {
      width: 50px; height: 50px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center; font-size: 22px;
    }

    /* TABLES & BOXES */
    .table-box {
      background: #fff; border: 1px solid var(--border-color);
      border-radius: 16px; padding: 24px; margin-top: 24px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
    .box-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .box-title { font-size: 17px; font-weight: 700; margin: 0; }
    .table { margin: 0; vertical-align: middle; }
    .table thead th {
      background: #f8fafc; font-size: 12px; text-transform: uppercase; color: var(--text-muted);
      font-weight: 700; letter-spacing: 0.5px; border-bottom: 1px solid var(--border-color); padding: 12px 16px;
    }
    .table tbody td { padding: 14px 16px; font-size: 14px; border-bottom: 1px solid var(--border-color); }

    /* BADGES */
    .status-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
    }
    .badge-paid { background: #dcfce7; color: #15803d; }
    .badge-sent { background: #e0e7ff; color: #4338ca; }
    .badge-partial { background: #fef3c7; color: #b45309; }
    .badge-overdue { background: #fee2e2; color: #b91c1c; }
    .badge-warranty { background: #ede9fe; color: #6d28d9; }
    .badge-passed { background: #dcfce7; color: #15803d; }

    /* MODAL STYLES */
    .modal-header { background: #f8fafc; border-bottom: 1px solid var(--border-color); }
    .modal-title { font-weight: 700; font-size: 17px; }

    /* INVOICE PRINT TEMPLATE */
    .invoice-print-sheet {
      background: #fff; padding: 36px; border: 1px solid var(--border-color); border-radius: 12px;
      font-family: 'Inter', sans-serif;
    }
    @media print {
      body * { visibility: hidden; }
      #modalInvoiceDetail, #modalInvoiceDetail * { visibility: visible; }
      #modalInvoiceDetail { position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 0; }
      .modal-footer, .btn-close { display: none !important; }
    }
    /* CLIENT PORTAL & ROLE SWITCHER STYLES */
    .client-hero-card {
      background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%);
      color: #fff;
      border-radius: 18px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 10px 25px rgba(67, 56, 202, 0.2);
      position: relative;
      overflow: hidden;
    }
    .client-hero-card::after {
      content: "";
      position: absolute;
      top: -60px; right: -60px;
      width: 240px; height: 240px;
      background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .client-subnav-btn {
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 13px;
      color: #475569;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .client-subnav-btn:hover {
      background: #e2e8f0;
      color: #0f172a;
    }
    .client-subnav-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }
    .bank-card {
      background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
      border: 1px dashed #94a3b8;
      border-radius: 14px;
      padding: 20px;
    }
    .role-dropdown-btn {
      background: #fff;
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.04);
      cursor: pointer;
      transition: all 0.2s;
    }
    .role-dropdown-btn:hover {
      background: #f8fafc;
      border-color: #cbd5e1;
    }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo-icon" id="sidebarLogoIcon"><i class="fa-solid fa-chart-pie"></i></div>
      <div>
        <div class="sidebar-title" id="sidebarMainTitle">GODDY RECRUIT</div>
        <div class="sidebar-subtitle" id="sidebarSubTitle">Quản Lý Công Nợ B2B</div>
      </div>
    </div>

    <!-- Menu Nội bộ (Admin, Kế toán, Recruiter) -->
    <ul class="sidebar-menu" id="sidebarMenuInternal">
      <li class="sidebar-item active" onclick="switchTab('dashboard')">
        <i class="fa-solid fa-gauge-high"></i> Dashboard Thống Kê
      </li>
      <li class="sidebar-item" onclick="switchTab('clients')">
        <i class="fa-solid fa-building-user"></i> Khách Hàng Doanh Nghiệp
      </li>
      <li class="sidebar-item" onclick="switchTab('recruitment')">
        <i class="fa-solid fa-briefcase"></i> Tuyển Dụng & Deal Onboard
      </li>
      <li class="sidebar-item" onclick="switchTab('invoices')">
        <i class="fa-solid fa-file-invoice-dollar"></i> Hóa Đơn & Invoicing
      </li>
      <li class="sidebar-item" onclick="switchTab('debt')">
        <i class="fa-solid fa-scale-unbalanced"></i> Công Nợ & Tuổi Nợ (Aging)
      </li>
      <li class="sidebar-item" onclick="switchTab('audit')">
        <i class="fa-solid fa-clock-rotate-left"></i> Nhật Ký Audit Log
      </li>
    </ul>

    <!-- Menu Cổng Khách Hàng (Client Portal) -->
    <ul class="sidebar-menu" id="sidebarMenuClient" style="display: none;">
      <li class="sidebar-item active" onclick="switchClientSubTab('invoices')">
        <i class="fa-solid fa-file-invoice-dollar"></i> Hóa Đơn & Thanh Toán
      </li>
      <li class="sidebar-item" onclick="switchClientSubTab('jobs')">
        <i class="fa-solid fa-briefcase"></i> Vị Trí Tuyển Dụng
      </li>
      <li class="sidebar-item" onclick="switchClientSubTab('placements')">
        <i class="fa-solid fa-user-check"></i> Ứng Viên & Bảo Hành (60d)
      </li>
      <li class="sidebar-item" onclick="switchClientSubTab('profile')">
        <i class="fa-solid fa-id-card"></i> Hồ Sơ Doanh Nghiệp
      </li>
    </ul>

    <div class="sidebar-footer" id="sidebarFooter">
      <div id="sidebarFooterInternal">
        <div><strong>Đồ án QLDA - Nhóm 10</strong></div>
        <div class="text-muted" style="font-size: 11px;">Phiên bản 1.0.0 (SQLite Enterprise)</div>
      </div>
      <div id="sidebarFooterClient" style="display: none;">
        <button class="btn btn-sm btn-outline-light w-100 mb-2" onclick="switchUserRole('admin')">
          <i class="fa-solid fa-arrow-left me-1"></i> Về quyền Quản trị
        </button>
        <div class="text-muted text-center" style="font-size: 11px;">Chế độ Cổng Khách Hàng B2B</div>
      </div>
    </div>
  </aside>

  <!-- MAIN WRAPPER -->
  <div class="main-wrapper">
    <header class="top-navbar">
      <h1 class="page-title" id="pageHeaderTitle">Dashboard Dữ Liệu Tuyển Dụng & Tài Chính</h1>
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="reloadCurrentTab()" title="Làm mới dữ liệu">
          <i class="fa-solid fa-rotate me-1"></i> Làm mới
        </button>

        <!-- Dropdown Chuyển Đổi Quyền / Tài Khoản -->
        <div class="dropdown">
          <button class="role-dropdown-btn dropdown-toggle" type="button" id="roleDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="badge bg-danger rounded-pill px-2 py-1" id="roleBadge">Admin</span>
            <span id="navRoleTitle">Huỳnh Nguyễn Vĩnh Phúc</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2" style="min-width: 320px; border-radius: 14px;">
            <li class="dropdown-header text-uppercase fw-bold text-muted small"><i class="fa-solid fa-users me-1"></i> Tài Khoản Nội Bộ</li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0)" onclick="switchUserRole('admin')">
                <span class="badge bg-danger rounded-pill">Admin</span>
                <div>
                  <div class="fw-bold small">Huỳnh Nguyễn Vĩnh Phúc</div>
                  <div class="text-muted" style="font-size: 11px;">Toàn quyền hệ thống & Giám sát</div>
                </div>
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0)" onclick="switchUserRole('accountant')">
                <span class="badge bg-success rounded-pill">Kế toán</span>
                <div>
                  <div class="fw-bold small">Phạm Sơn (Kế toán trưởng)</div>
                  <div class="text-muted" style="font-size: 11px;">Hóa đơn, Công nợ, Ghi nhận thu tiền</div>
                </div>
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0)" onclick="switchUserRole('recruiter')">
                <span class="badge bg-warning text-dark rounded-pill">Recruiter</span>
                <div>
                  <div class="fw-bold small">Nguyễn Văn Minh (Senior)</div>
                  <div class="text-muted" style="font-size: 11px;">Quản lý ứng viên & Deal onboard</div>
                </div>
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li class="dropdown-header text-uppercase fw-bold text-primary small"><i class="fa-solid fa-building me-1"></i> Cổng Khách Hàng (Client Portal)</li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0)" onclick="switchUserRole('client', 1)">
                <span class="badge bg-primary rounded-pill">Khách hàng</span>
                <div>
                  <div class="fw-bold small">FPT Software (Trần Thu Hà)</div>
                  <div class="text-muted" style="font-size: 11px;">Tài khoản: fpt_client (Net 30)</div>
                </div>
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0)" onclick="switchUserRole('client', 2)">
                <span class="badge bg-primary rounded-pill">Khách hàng</span>
                <div>
                  <div class="fw-bold small">VNG Corporation (Nguyễn Hoàng Long)</div>
                  <div class="text-muted" style="font-size: 11px;">Tài khoản: vng_client (Net 30)</div>
                </div>
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0)" onclick="switchUserRole('client', 3)">
                <span class="badge bg-primary rounded-pill">Khách hàng</span>
                <div>
                  <div class="fw-bold small">Shopee Việt Nam (Lê Thùy Dương)</div>
                  <div class="text-muted" style="font-size: 11px;">Tài khoản: shopee_client (Net 45)</div>
                </div>
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <a class="dropdown-item text-center text-primary fw-bold small py-2" href="javascript:void(0)" onclick="openLoginModal()">
                <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập bằng tài khoản khác...
              </a>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <main class="content-container">

      <!-- ================= SECTION 1: DASHBOARD ================= -->
      <div id="section-dashboard">
        <!-- 4 Metric Cards -->
        <div class="row g-4">
          <div class="col-md-3">
            <div class="metric-card">
              <div>
                <div class="metric-title">Doanh Thu Đã Thu</div>
                <div class="metric-value text-success" id="valTotalRevenue">0 đ</div>
              </div>
              <div class="metric-icon-box bg-success-subtle text-success">
                <i class="fa-solid fa-sack-dollar"></i>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="metric-card">
              <div>
                <div class="metric-title">Tổng Nợ Cần Thu (AR)</div>
                <div class="metric-value text-primary" id="valTotalAR">0 đ</div>
              </div>
              <div class="metric-icon-box bg-primary-subtle text-primary">
                <i class="fa-solid fa-receipt"></i>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="metric-card">
              <div>
                <div class="metric-title">Nợ Quá Hạn Cần Đòi</div>
                <div class="metric-value text-danger" id="valOverdueAR">0 đ</div>
              </div>
              <div class="metric-icon-box bg-danger-subtle text-danger">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="metric-card">
              <div>
                <div class="metric-title">Deal Thành Công</div>
                <div class="metric-value text-warning" id="valPlacementCount">0 Deals</div>
              </div>
              <div class="metric-icon-box bg-warning-subtle text-warning">
                <i class="fa-solid fa-handshake"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- KPI Ratios -->
        <div class="row g-4 mt-2">
          <div class="col-md-6">
            <div class="p-3 bg-white border rounded-3 d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-bold text-uppercase">Tỷ Lệ Thu Hồi Công Nợ</span>
                <h4 class="mb-0 text-success fw-bold" id="valCollectionRate">0%</h4>
              </div>
              <i class="fa-solid fa-chart-line text-success fs-2 opacity-75"></i>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 bg-white border rounded-3 d-flex align-items-center justify-content-between">
              <div>
                <span class="text-muted small fw-bold text-uppercase">Tỷ Lệ Nợ Quá Hạn / Tổng Nợ</span>
                <h4 class="mb-0 text-danger fw-bold" id="valBadDebtRate">0%</h4>
              </div>
              <i class="fa-solid fa-chart-pie text-danger fs-2 opacity-75"></i>
            </div>
          </div>
        </div>

        <!-- 2 Charts -->
        <div class="row g-4 mt-2">
          <div class="col-lg-8">
            <div class="table-box mt-0">
              <div class="box-header">
                <h3 class="box-title"><i class="fa-solid fa-chart-area text-primary me-2"></i>Doanh Thu Tuyển Dụng Theo Tháng (Triệu VNĐ)</h3>
              </div>
              <canvas id="revenueChart" height="110"></canvas>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="table-box mt-0">
              <div class="box-header">
                <h3 class="box-title"><i class="fa-solid fa-chart-pie text-success me-2"></i>Cơ Cấu Khách Hàng Theo Ngành</h3>
              </div>
              <canvas id="industryChart" height="230"></canvas>
            </div>
          </div>
        </div>

        <!-- Top 5 Debtor Clients -->
        <div class="table-box">
          <div class="box-header">
            <h3 class="box-title"><i class="fa-solid fa-fire text-danger me-2"></i>Top 5 Doanh Nghiệp Có Công Nợ Cần Thu Hồi Lớn Nhất</h3>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Tên Doanh Nghiệp</th>
                  <th>Mã Số Thuế</th>
                  <th>Số Hóa Đơn Nợ</th>
                  <th>Tổng Nợ Còn Lại</th>
                  <th>Thao Tác</th>
                </tr>
              </thead>
              <tbody id="topDebtorsTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= SECTION 2: CLIENTS ================= -->
      <div id="section-clients" style="display: none;">
        <div class="table-box mt-0">
          <div class="box-header">
            <div>
              <h3 class="box-title"><i class="fa-solid fa-building text-primary me-2"></i>Danh Sách Khách Hàng Doanh Nghiệp (B2B)</h3>
              <div class="text-muted small mt-1">Quản lý thông tin công ty, mã số thuế và điều khoản thanh toán Net Days</div>
            </div>
            <div class="d-flex gap-2">
              <input type="text" class="form-control form-control-sm" id="clientSearchInput" placeholder="Tìm theo tên / MST..." oninput="filterClientsTable()" style="width: 220px;">
              <button class="btn btn-sm btn-outline-success" onclick="exportClientsCSV()"><i class="fa-solid fa-file-csv me-1"></i>Xuất CSV</button>
              <button class="btn btn-sm btn-primary" onclick="openModalAddClient()"><i class="fa-solid fa-plus me-1"></i>Thêm Khách Hàng</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Doanh Nghiệp / Địa Chỉ</th>
                  <th>Mã Số Thuế</th>
                  <th>Người Liên Hệ</th>
                  <th>Email & SĐT</th>
                  <th>Hạn Thanh Toán</th>
                  <th>Trạng Thái</th>
                </tr>
              </thead>
              <tbody id="clientsTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= SECTION 3: RECRUITMENT & PLACEMENTS ================= -->
      <div id="section-recruitment" style="display: none;">
        <div class="table-box mt-0">
          <div class="box-header">
            <div>
              <h3 class="box-title"><i class="fa-solid fa-handshake text-success me-2"></i>Deal Tuyển Dụng Onboard & Thời Hạn Bảo Hành</h3>
              <div class="text-muted small mt-1">Theo dõi ứng viên đi làm, phí dịch vụ hoa hồng và thời hạn bảo hành 60 ngày</div>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-primary" onclick="openModalAddPlacement()"><i class="fa-solid fa-plus me-1"></i>Chốt Deal Tuyển Dụng</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Ứng Viên</th>
                  <th>Vị Trí Tuyển</th>
                  <th>Khách Hàng (Công Ty)</th>
                  <th>Lương Chính Thức</th>
                  <th>Phí Dịch Vụ</th>
                  <th>Ngày Hết Bảo Hành</th>
                  <th>Trạng Thái</th>
                  <th>Hóa Đơn</th>
                </tr>
              </thead>
              <tbody id="placementsTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= SECTION 4: INVOICES ================= -->
      <div id="section-invoices" style="display: none;">
        <div class="table-box mt-0">
          <div class="box-header">
            <div>
              <h3 class="box-title"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Danh Sách Hóa Đơn Dịch Vụ Tuyển Dụng</h3>
              <div class="text-muted small mt-1">Quản lý hóa đơn VAT phát hành từ deal tuyển dụng và theo dõi thanh toán</div>
            </div>
            <div class="d-flex gap-2">
              <select class="form-select form-select-sm" id="invoiceFilterStatus" onchange="loadInvoices()" style="width: 170px;">
                <option value="All">Tất cả trạng thái</option>
                <option value="Sent">Chờ thanh toán (Sent)</option>
                <option value="Partial">Trả một phần (Partial)</option>
                <option value="Paid">Đã tất toán (Paid)</option>
                <option value="Overdue">Quá hạn (Overdue)</option>
              </select>
              <button class="btn btn-sm btn-outline-success" onclick="exportInvoicesCSV()"><i class="fa-solid fa-file-csv me-1"></i>Xuất CSV</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
