                <div class="metric-value text-danger" id="debtAging1to30">0 đ</div>
              </div>
              <i class="fa-solid fa-clock text-danger fs-2"></i>
            </div>
          </div>
          <div class="col-md-4">
            <div class="metric-card border-warning">
              <div>
                <div class="metric-title text-warning">Quá Hạn 31 - 60 Ngày</div>
                <div class="metric-value text-warning" id="debtAging31to60">0 đ</div>
              </div>
              <i class="fa-solid fa-calendar-xmark text-warning fs-2"></i>
            </div>
          </div>
          <div class="col-md-4">
            <div class="metric-card border-dark">
              <div>
                <div class="metric-title text-dark">Nợ Khó Đòi (> 60 Ngày)</div>
                <div class="metric-value text-dark" id="debtAgingAbove60">0 đ</div>
              </div>
              <i class="fa-solid fa-ban text-dark fs-2"></i>
            </div>
          </div>
        </div>

        <div class="table-box">
          <div class="box-header">
            <h3 class="box-title"><i class="fa-solid fa-table-list text-danger me-2"></i>Chi Tiết Công Nợ Từng Hóa Đơn & Tuổi Nợ (Aging Report)</h3>
            <button class="btn btn-sm btn-outline-success" onclick="exportDebtCSV()"><i class="fa-solid fa-file-csv me-1"></i>Xuất CSV Báo Cáo</button>
