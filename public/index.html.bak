  <!-- ================= MODAL: THÊM KHÁCH HÀNG B2B ================= -->
  <div class="modal fade" id="modalAddClient" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-building me-2 text-primary"></i>Thêm Khách Hàng Doanh Nghiệp Mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="formAddClient" onsubmit="submitAddClient(event)">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-bold">Tên công ty / Doanh nghiệp (*)</label>
              <input type="text" class="form-control" id="newClientName" required placeholder="Ví dụ: Công ty Cổ phần Công nghệ ABC">
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Mã số thuế (*)</label>
                <input type="text" class="form-control" id="newClientTaxCode" required placeholder="10 hoặc 13 số">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Điều khoản thanh toán</label>
                <select class="form-select" id="newClientNetDays">
                  <option value="15">Net 15 ngày</option>
                  <option value="30" selected>Net 30 ngày (Tiêu chuẩn)</option>
                  <option value="45">Net 45 ngày</option>
                  <option value="60">Net 60 ngày</option>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Địa chỉ trụ sở</label>
              <input type="text" class="form-control" id="newClientAddress" placeholder="Quận / Thành phố...">
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Người liên hệ</label>
                <input type="text" class="form-control" id="newClientContactPerson" placeholder="Họ và tên nhân sự">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Số điện thoại</label>
                <input type="text" class="form-control" id="newClientContactPhone" placeholder="090...">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Email liên hệ nhận hóa đơn</label>
              <input type="email" class="form-control" id="newClientContactEmail" placeholder="ketoan@doanhnghiep.com">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu Khách Hàng</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: CHỐT DEAL TUYỂN DỤNG ================= -->
  <div class="modal fade" id="modalAddPlacement" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-handshake me-2 text-success"></i>Ghi Nhận Deal Tuyển Dụng Mới (Onboard)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="formAddPlacement" onsubmit="submitAddPlacement(event)">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-bold">Khách hàng (Doanh nghiệp) (*)</label>
              <select class="form-select" id="placementClientId" required onchange="onSelectClientForPlacement()">
                <option value="">-- Chọn khách hàng --</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Vị trí tuyển dụng (Job) (*)</label>
              <select class="form-select" id="placementJobId" required>
                <option value="">-- Chọn vị trí tuyển dụng --</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Ứng viên (*)</label>
              <select class="form-select" id="placementCandidateId" required>
                <option value="">-- Chọn ứng viên --</option>
              </select>
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Mức lương thỏa thuận (VNĐ) (*)</label>
                <input type="number" class="form-control" id="placementSalary" required placeholder="Ví dụ: 40000000" oninput="calcPlacementFee()">
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Tỷ lệ phí dịch vụ (%)</label>
                <input type="number" class="form-control" id="placementFeeRate" value="18" step="0.5" oninput="calcPlacementFee()">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Phí dịch vụ ước tính (VNĐ)</label>
              <input type="text" class="form-control fw-bold text-success bg-light" id="placementEstFee" readonly value="0 đ">
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Ngày ứng viên Onboard (*)</label>
                <input type="date" class="form-control" id="placementOnboardDate" required>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Thời hạn bảo hành (Ngày)</label>
                <input type="number" class="form-control" id="placementWarrantyDays" value="60">
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-success"><i class="fa-solid fa-check me-1"></i>Chốt Deal</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: GHI NHẬN THANH TOÁN (TRẢ NỢ) ================= -->
  <div class="modal fade" id="modalRecordPayment" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-money-bill-wave me-2 text-success"></i>Ghi Nhận Thanh Toán Công Nợ</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="formRecordPayment" onsubmit="submitRecordPayment(event)">
          <div class="modal-body">
            <input type="hidden" id="payInvoiceId">
            <div class="mb-3">
              <label class="form-label fw-bold">Hóa đơn thanh toán</label>
              <input type="text" class="form-control bg-light" id="payInvoiceCode" readonly>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Số tiền nợ còn lại</label>
              <input type="text" class="form-control bg-light fw-bold text-danger" id="payRemainingText" readonly>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Số tiền khách hàng thanh toán (VNĐ) (*)</label>
              <input type="number" class="form-control" id="payAmount" required placeholder="Nhập số tiền trả">
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Phương thức thanh toán</label>
                <select class="form-select" id="payMethod">
                  <option value="BankTransfer">Chuyển khoản ngân hàng</option>
                  <option value="Cash">Tiền mặt</option>
                  <option value="CreditCard">Thẻ tín dụng doanh nghiệp</option>
                </select>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Mã tham chiếu / Ủy nhiệm chi</label>
                <input type="text" class="form-control" id="payRefCode" placeholder="FT...">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Ghi chú</label>
              <textarea class="form-control" id="payNotes" rows="2" placeholder="Ví dụ: Đã nhận tiền từ tài khoản Techcombank"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-success"><i class="fa-solid fa-circle-check me-1"></i>Xác Nhận Thu Tiền</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: XEM & IN HÓA ĐƠN PDF ================= -->
  <div class="modal fade" id="modalInvoiceDetail" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-file-invoice me-2 text-primary"></i>Hóa Đơn Giá Trị Gia Tăng (VAT)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="invoice-print-sheet" id="invoicePrintSheet">
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
              <div>
                <h4 class="fw-bold text-primary mb-1">GODDY RECRUITMENT SERVICES</h4>
                <div class="text-muted small">Cung cấp dịch vụ Tuyển dụng & Headhunting cao cấp</div>
                <div class="text-muted small">Địa chỉ: Tòa nhà TechHub, Cầu Giấy, Hà Nội</div>
                <div class="text-muted small">Mã số thuế: 0109988776</div>
              </div>
              <div class="text-end">
                <h3 class="fw-bold mb-1" id="invDetailCode">INV-2026-0001</h3>
                <div class="text-muted small">Ngày lập: <span id="invDetailIssueDate">--</span></div>
                <div class="text-danger small fw-bold">Hạn thanh toán: <span id="invDetailDueDate">--</span></div>
              </div>
            </div>

            <div class="row mb-4">
              <div class="col-6">
                <div class="text-muted small text-uppercase fw-bold">Khách hàng (Người mua)</div>
                <h5 class="fw-bold mb-1" id="invDetailClientName">Công ty Cổ phần FPT Software</h5>
                <div class="small">Mã số thuế: <strong id="invDetailTaxCode">--</strong></div>
                <div class="small text-muted" id="invDetailAddress">--</div>
              </div>
              <div class="col-6 text-end">
                <div class="text-muted small text-uppercase fw-bold">Trạng thái thanh toán</div>
                <div id="invDetailStatusBadge" class="mt-1"></div>
              </div>
            </div>

            <table class="table table-bordered mb-4">
              <thead class="table-light">
                <tr>
                  <th>Nội Dung Dịch Vụ</th>
                  <th>Ứng Viên / Vị Trí</th>
                  <th class="text-end">Thành Tiền (VNĐ)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Phí dịch vụ Headhunt tuyển dụng nhân sự chính thức</td>
                  <td id="invDetailPlacementInfo">Senior NodeJS Engineer</td>
                  <td class="text-end fw-bold" id="invDetailSubtotal">0 đ</td>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="2" class="text-end text-muted">Cộng tiền dịch vụ:</td>
                  <td class="text-end fw-bold" id="invDetailSubtotalFoot">0 đ</td>
                </tr>
                <tr>
                  <td colspan="2" class="text-end text-muted">Thuế suất GTGT (VAT 8%):</td>
                  <td class="text-end text-muted" id="invDetailVat">0 đ</td>
                </tr>
                <tr class="table-light">
                  <td colspan="2" class="text-end fw-bold fs-6">TỔNG CỘNG THANH TOÁN:</td>
                  <td class="text-end fw-bold text-primary fs-5" id="invDetailTotal">0 đ</td>
                </tr>
                <tr>
                  <td colspan="2" class="text-end text-success">Đã thanh toán:</td>
                  <td class="text-end text-success fw-bold" id="invDetailPaid">0 đ</td>
                </tr>
                <tr>
                  <td colspan="2" class="text-end text-danger fw-bold">CÒN PHẢI THU:</td>
                  <td class="text-end text-danger fw-bold fs-6" id="invDetailRemaining">0 đ</td>
                </tr>
              </tfoot>
            </table>

            <div class="row pt-4 text-center">
              <div class="col-6">
                <div class="fw-bold">Đại Diện Khách Hàng</div>
                <div class="text-muted small mt-1">(Ký, ghi rõ họ tên)</div>
              </div>
              <div class="col-6">
                <div class="fw-bold">Đại Diện GODDY Recruit</div>
                <div class="text-muted small mt-1">(Ký, đóng dấu điện tử)</div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i>In / Xuất PDF
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: KHÁCH HÀNG GỬI YÊU CẦU TUYỂN DỤNG ================= -->
  <div class="modal fade" id="modalClientRequestJob" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-paper-plane me-2 text-primary"></i>Gửi Yêu Cầu Tuyển Dụng Mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="formClientRequestJob" onsubmit="submitClientRequestJob(event)">
          <div class="modal-body">
            <div class="alert alert-primary py-2 px-3 small border-0 bg-primary-subtle text-primary-emphasis mb-3">
              Yêu cầu của bạn sẽ được chuyển trực tiếp tới đội ngũ Headhunter của GODDY Recruit để bắt đầu săn nhân sự.
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Chức danh / Vị trí tuyển dụng (*)</label>
              <input type="text" class="form-control" id="cpJobTitle" required placeholder="Ví dụ: Senior Data Engineer, Trưởng phòng Marketing...">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Khối / Phòng ban (*)</label>
              <input type="text" class="form-control" id="cpJobDepartment" required placeholder="Ví dụ: Khối Công nghệ thông tin, Ban Tài chính...">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Dải lương dự kiến (Gross)</label>
              <input type="text" class="form-control" id="cpJobSalary" placeholder="Ví dụ: 30 - 45 triệu VND, Thỏa thuận theo năng lực...">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Gửi Yêu Cầu Cho GODDY</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ================= MODAL: ĐĂNG NHẬP HỆ THỐNG ================= -->
  <div class="modal fade" id="modalLogin" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
        <div class="modal-header border-0 pb-0">
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body px-4 pt-0 pb-4">
          <div class="text-center mb-4">
            <div class="sidebar-logo-icon mx-auto mb-2" style="width: 50px; height: 50px; font-size: 24px;">
              <i class="fa-solid fa-lock"></i>
            </div>
            <h4 class="fw-bold">Đăng Nhập Hệ Thống</h4>
            <div class="text-muted small">GODDY Recruit - Quản trị Tài chính Tuyển dụng</div>
          </div>

          <form id="formLogin" onsubmit="submitLogin(event)">
            <div class="mb-3">
              <label class="form-label fw-bold small">Tên đăng nhập</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                <input type="text" class="form-control border-start-0" id="loginUsername" required placeholder="admin / ketoan / recruiter / fpt_client">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">Mật khẩu</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                <input type="password" class="form-control border-start-0" id="loginPassword" required value="123456">
              </div>
              <div class="form-text small">Mật khẩu mặc định cho tất cả tài khoản: <code>123456</code></div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm mt-3" style="border-radius: 12px;">
              <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng Nhập
            </button>
          </form>

          <div class="mt-4 pt-3 border-top">
            <div class="small fw-bold text-muted mb-2 text-center">Hoặc chọn nhanh tài khoản thử nghiệm:</div>
            <div class="d-flex flex-wrap gap-1 justify-content-center">
              <button class="btn btn-sm btn-outline-danger" onclick="quickFillLogin('admin', '123456')">Admin</button>
              <button class="btn btn-sm btn-outline-success" onclick="quickFillLogin('ketoan', '123456')">Kế toán</button>
              <button class="btn btn-sm btn-outline-warning text-dark" onclick="quickFillLogin('recruiter', '123456')">Recruiter</button>
              <button class="btn btn-sm btn-outline-primary" onclick="quickFillLogin('fpt_client', '123456')">FPT Software</button>
              <button class="btn btn-sm btn-outline-primary" onclick="quickFillLogin('vng_client', '123456')">VNG</button>
              <button class="btn btn-sm btn-outline-primary" onclick="quickFillLogin('shopee_client', '123456')">Shopee</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- APP LOGIC SCRIPT -->
  <script>
    let globalClients = [];
    let globalJobs = [];
    let globalCandidates = [];
    let revenueChartInstance = null;
    let industryChartInstance = null;

    let currentUserRole = 'admin'; // 'admin', 'accountant', 'recruiter', 'client'
    let currentClientId = 1;
    let currentUser = {
      username: 'admin',
      fullName: 'Huỳnh Nguyễn Vĩnh Phúc',
      role: 'admin'
    };

    // Chuyển Tab
    function switchTab(tabKey) {
      if (currentUserRole === 'client') {
        switchUserRole('admin');
        return;
      }
      const sections = ['dashboard', 'clients', 'recruitment', 'invoices', 'debt', 'audit', 'client-portal'];
      sections.forEach(s => {
        const el = document.getElementById('section-' + s);
        if (el) el.style.display = (s === tabKey) ? 'block' : 'none';
      });

      document.querySelectorAll('#sidebarMenuInternal .sidebar-item').forEach(item => item.classList.remove('active'));
      const activeItem = Array.from(document.querySelectorAll('#sidebarMenuInternal .sidebar-item')).find(el => el.getAttribute('onclick')?.includes(tabKey));
      if (activeItem) activeItem.classList.add('active');

      const titles = {
        'dashboard': 'Dashboard Dữ Liệu Tuyển Dụng & Tài Chính',
        'clients': 'Quản Lý Khách Hàng Doanh Nghiệp (B2B)',
        'recruitment': 'Quản Lý Deal Tuyển Dụng & Thời Hạn Bảo Hành',
        'invoices': 'Quản Lý Hóa Đơn Dịch Vụ Tuyển Dụng',
        'debt': 'Báo Cáo Công Nợ & Phân Tích Tuổi Nợ (Aging Report)',
        'audit': 'Nhật Ký Thao Tác Hệ Thống (Audit Trail)'
      };
      document.getElementById('pageHeaderTitle').textContent = titles[tabKey] || 'GODDY RECRUIT';

      if (tabKey === 'dashboard') loadDashboard();
      if (tabKey === 'clients') loadClients();
      if (tabKey === 'recruitment') loadPlacements();
      if (tabKey === 'invoices') loadInvoices();
      if (tabKey === 'debt') loadDebt();
      if (tabKey === 'audit') loadAudit();
    }

    function reloadCurrentTab() {
      if (currentUserRole === 'client') {
        loadClientPortal(currentClientId);
      } else {
        const activeItem = document.querySelector('#sidebarMenuInternal .sidebar-item.active');
        if (activeItem) activeItem.click();
      }
    }

    function formatMoney(amount) {
      return (parseFloat(amount) || 0).toLocaleString('vi-VN') + ' đ';
    }

    // ================= DASHBOARD =================
    async function loadDashboard() {
      try {
        const res = await fetch('/api/dashboard/stats');
        const data = await res.json();
        if (data.success) {
          document.getElementById('valTotalRevenue').textContent = formatMoney(data.stats.totalRevenue);
          document.getElementById('valTotalAR').textContent = formatMoney(data.stats.totalAR);
          document.getElementById('valOverdueAR').textContent = formatMoney(data.stats.overdueAR);
          document.getElementById('valPlacementCount').textContent = data.stats.placementCount + ' Deals';
          document.getElementById('valCollectionRate').textContent = data.stats.collectionRate + '%';
          document.getElementById('valBadDebtRate').textContent = data.stats.badDebtRate + '%';

          initCharts(data.chartData);

          // Render Top 5 Debtors
          const tbody = document.getElementById('topDebtorsTableBody');
          tbody.innerHTML = '';
          if (data.topDebtors && data.topDebtors.length > 0) {
            data.topDebtors.forEach(td => {
              tbody.innerHTML += `
                <tr>
                  <td><strong>${td.companyName}</strong></td>
                  <td><code>${td.taxCode}</code></td>
                  <td><span class="badge bg-secondary">${td.invoiceCount} hóa đơn</span></td>
                  <td class="text-danger fw-bold">${formatMoney(td.totalRemaining)}</td>
                  <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="switchTab('debt')">
                      <i class="fa-solid fa-eye me-1"></i>Xem Chi Tiết
                    </button>
                  </td>
                </tr>
              `;
            });
          } else {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Hiện không có công nợ tồn đọng!</td></tr>';
          }
        }
      } catch (err) {
        console.error('Lỗi tải Dashboard:', err);
      }
    }

    function initCharts(chartData) {
      if (revenueChartInstance) revenueChartInstance.destroy();
      if (industryChartInstance) industryChartInstance.destroy();

      const ctxRev = document.getElementById('revenueChart').getContext('2d');
      revenueChartInstance = new Chart(ctxRev, {
        type: 'line',
        data: {
          labels: chartData.labels,
          datasets: [{
            label: 'Doanh thu thực tế (triệu VNĐ)',
            data: chartData.revenueByMonth,
            borderColor: '#4f46e5',
            backgroundColor: 'rgba(79, 70, 229, 0.08)',
            fill: true,
            tension: 0.35,
            borderWidth: 3,
            pointBackgroundColor: '#4f46e5',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            y: { grid: { color: '#f1f5f9' }, ticks: { callback: v => v + ' tr' } },
            x: { grid: { display: false } }
          }
        }
      });

      const ctxInd = document.getElementById('industryChart').getContext('2d');
      industryChartInstance = new Chart(ctxInd, {
        type: 'doughnut',
        data: {
          labels: chartData.industryShare.labels,
          datasets: [{
            data: chartData.industryShare.series,
            backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#ec4899', '#64748b'],
            borderWidth: 2,
            borderColor: '#fff'
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } } }
        }
      });
    }

    // ================= CLIENTS =================
    async function loadClients() {
      const res = await fetch('/api/clients');
      const data = await res.json();
      globalClients = data.clients || [];
      renderClientsTable(globalClients);
    }

    function renderClientsTable(clients) {
      const tbody = document.getElementById('clientsTableBody');
      tbody.innerHTML = '';
      if (!clients || clients.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">Không có khách hàng nào.</td></tr>';
        return;
      }
      clients.forEach(c => {
        tbody.innerHTML += `
          <tr>
            <td>
              <strong>${c.companyName}</strong><br>
              <small class="text-muted">${c.address || 'Chưa cập nhật'}</small>
            </td>
            <td><code>${c.taxCode}</code></td>
            <td>${c.contactPerson || '-'}</td>
            <td>
              <small>${c.contactEmail || '-'}</small><br>
              <small class="text-muted">${c.contactPhone || ''}</small>
            </td>
            <td><span class="badge bg-secondary">Net ${c.paymentTermDays} ngày</span></td>
            <td><span class="status-badge badge-paid">${c.status}</span></td>
          </tr>
        `;
      });
    }

    function filterClientsTable() {
      const q = document.getElementById('clientSearchInput').value.toLowerCase();
      const filtered = globalClients.filter(c =>
        c.companyName.toLowerCase().includes(q) ||
        c.taxCode.toLowerCase().includes(q) ||
        (c.contactPerson && c.contactPerson.toLowerCase().includes(q))
      );
      renderClientsTable(filtered);
    }

    function openModalAddClient() {
      document.getElementById('formAddClient').reset();
      new bootstrap.Modal(document.getElementById('modalAddClient')).show();
    }

    async function submitAddClient(e) {
      e.preventDefault();
      const body = {
        companyName: document.getElementById('newClientName').value,
        taxCode: document.getElementById('newClientTaxCode').value,
        paymentTermDays: document.getElementById('newClientNetDays').value,
        address: document.getElementById('newClientAddress').value,
        contactPerson: document.getElementById('newClientContactPerson').value,
        contactPhone: document.getElementById('newClientContactPhone').value,
        contactEmail: document.getElementById('newClientContactEmail').value
      };

      const res = await fetch('/api/clients', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('modalAddClient')).hide();
        alert('Thêm khách hàng doanh nghiệp thành công!');
        loadClients();
      } else {
        alert(data.message || 'Có lỗi xảy ra!');
      }
    }

    // ================= PLACEMENTS =================
    async function loadPlacements() {
      const res = await fetch('/api/recruitment/placements');
      const data = await res.json();
      const tbody = document.getElementById('placementsTableBody');
      tbody.innerHTML = '';
      if (!data.placements || data.placements.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Chưa có deal tuyển dụng nào.</td></tr>';
        return;
      }
      data.placements.forEach(p => {
        const isWarranty = p.status === 'UnderWarranty';
        const hasInvoice = p.Invoice != null;
        tbody.innerHTML += `
          <tr>
            <td><strong>${p.Candidate ? p.Candidate.fullName : '-'}</strong></td>
            <td>${p.Job ? p.Job.title : '-'}</td>
            <td>${p.Client ? p.Client.companyName : '-'}</td>
            <td>${formatMoney(p.officialSalary)}</td>
            <td class="text-success fw-bold">${formatMoney(p.serviceFee)}</td>
            <td><i class="fa-regular fa-calendar-check me-1"></i>${p.warrantyEndDate || '-'}</td>
            <td><span class="status-badge ${isWarranty ? 'badge-warranty' : 'badge-passed'}">${p.status}</span></td>
            <td>
              ${hasInvoice ? `<span class="badge bg-success">${p.Invoice.invoiceCode}</span>` : `
                <button class="btn btn-sm btn-outline-primary" onclick="quickIssueInvoice(${p.id})">
                  <i class="fa-solid fa-file-invoice me-1"></i>Xuất HĐ
                </button>
              `}
            </td>
          </tr>
        `;
      });
    }

    async function openModalAddPlacement() {
      document.getElementById('formAddPlacement').reset();
      document.getElementById('placementOnboardDate').valueAsDate = new Date();

      // Load clients
      const resClients = await fetch('/api/clients');
      const dClients = await resClients.json();
      const clientSelect = document.getElementById('placementClientId');
      clientSelect.innerHTML = '<option value="">-- Chọn khách hàng --</option>';
      (dClients.clients || []).forEach(c => {
        clientSelect.innerHTML += `<option value="${c.id}">${c.companyName}</option>`;
      });

      // Load candidates
      const resCand = await fetch('/api/recruitment/candidates');
      const dCand = await resCand.json();
      const candSelect = document.getElementById('placementCandidateId');
      candSelect.innerHTML = '<option value="">-- Chọn ứng viên --</option>';
      (dCand.candidates || []).forEach(c => {
        candSelect.innerHTML += `<option value="${c.id}">${c.fullName} (${c.currentPosition || ''})</option>`;
      });

      new bootstrap.Modal(document.getElementById('modalAddPlacement')).show();
    }

    async function onSelectClientForPlacement() {
      const cId = document.getElementById('placementClientId').value;
      const jobSelect = document.getElementById('placementJobId');
      jobSelect.innerHTML = '<option value="">-- Đang tải vị trí... --</option>';
      if (!cId) {
        jobSelect.innerHTML = '<option value="">-- Chọn khách hàng trước --</option>';
        return;
      }

      const res = await fetch('/api/recruitment/jobs');
      const d = await res.json();
      const clientJobs = (d.jobs || []).filter(j => j.clientId == cId);
      jobSelect.innerHTML = '';
      if (clientJobs.length === 0) {
        jobSelect.innerHTML = '<option value="">(Khách hàng này chưa có Job mở)</option>';
      } else {
        clientJobs.forEach(j => {
          jobSelect.innerHTML += `<option value="${j.id}">${j.title} (${j.department})</option>`;
        });
      }
    }

    function calcPlacementFee() {
      const salary = parseFloat(document.getElementById('placementSalary').value) || 0;
      const rate = parseFloat(document.getElementById('placementFeeRate').value) || 18;
      // Headhunt standard: rate% của lương năm (12 tháng)
      const fee = salary * 12 * (rate / 100);
      document.getElementById('placementEstFee').value = formatMoney(fee);
    }

    async function submitAddPlacement(e) {
      e.preventDefault();
      const body = {
        clientId: document.getElementById('placementClientId').value,
        jobId: document.getElementById('placementJobId').value,
        candidateId: document.getElementById('placementCandidateId').value,
        officialSalary: document.getElementById('placementSalary').value,
        feeRatePercent: document.getElementById('placementFeeRate').value,
        onboardDate: document.getElementById('placementOnboardDate').value,
        warrantyDays: document.getElementById('placementWarrantyDays').value
      };

      const res = await fetch('/api/recruitment/placements', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('modalAddPlacement')).hide();
        alert('Ghi nhận deal tuyển dụng thành công!');
        loadPlacements();
      } else {
        alert(data.message || 'Lỗi khi chốt deal!');
      }
    }

    async function quickIssueInvoice(placementId) {
      if (!confirm('Bạn có chắc chắn muốn phát hành hóa đơn VAT cho deal tuyển dụng này?')) return;
      const res = await fetch('/api/invoices/from-placement', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ placementId, vatRate: 8.0 })
      });
      const data = await res.json();
      if (data.success) {
        alert(`Phát hành hóa đơn thành công! Mã HĐ: ${data.invoice.invoiceCode}`);
        loadPlacements();
      } else {
        alert(data.message || 'Lỗi phát hành hóa đơn!');
      }
    }

    // ================= INVOICES =================
    async function loadInvoices() {
      const status = document.getElementById('invoiceFilterStatus').value;
      const url = status === 'All' ? '/api/invoices' : `/api/invoices?status=${status}`;
      const res = await fetch(url);
      const data = await res.json();
      const tbody = document.getElementById('invoicesTableBody');
      tbody.innerHTML = '';
      if (!data.invoices || data.invoices.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Không có hóa đơn nào.</td></tr>';
        return;
      }
      data.invoices.forEach(inv => {
        let badgeClass = 'badge-sent';
        if (inv.status === 'Paid') badgeClass = 'badge-paid';
        if (inv.status === 'Partial') badgeClass = 'badge-partial';
        if (inv.status === 'Overdue') badgeClass = 'badge-overdue';

        tbody.innerHTML += `
          <tr>
            <td><strong>${inv.invoiceCode}</strong></td>
            <td>${inv.Client ? inv.Client.companyName : '-'}</td>
            <td class="fw-bold">${formatMoney(inv.totalAmount)}</td>
            <td class="text-success">${formatMoney(inv.paidAmount)}</td>
            <td class="text-danger fw-bold">${formatMoney(inv.remainingAmount)}</td>
            <td>${inv.dueDate}</td>
            <td><span class="status-badge ${badgeClass}">${inv.status}</span></td>
            <td>
              <button class="btn btn-sm btn-outline-primary" onclick="viewInvoiceDetail(${inv.id})">
                <i class="fa-solid fa-file-lines me-1"></i>Xem & In
              </button>
            </td>
          </tr>
        `;
      });
    }

    async function viewInvoiceDetail(invoiceId) {
      const res = await fetch(`/api/invoices/${invoiceId}`);
      const data = await res.json();
      if (!data.success || !data.invoice) return alert('Không tìm thấy thông tin hóa đơn!');
      const inv = data.invoice;

      document.getElementById('invDetailCode').textContent = inv.invoiceCode;
      document.getElementById('invDetailIssueDate').textContent = inv.issueDate;
      document.getElementById('invDetailDueDate').textContent = inv.dueDate;
      document.getElementById('invDetailClientName').textContent = inv.Client ? inv.Client.companyName : '-';
      document.getElementById('invDetailTaxCode').textContent = inv.Client ? inv.Client.taxCode : '-';
      document.getElementById('invDetailAddress').textContent = inv.Client ? inv.Client.address : '-';

      const candidateName = inv.Placement?.Candidate?.fullName || 'Ứng viên';
      const jobTitle = inv.Placement?.Job?.title || 'Chuyên viên';
      document.getElementById('invDetailPlacementInfo').textContent = `${candidateName} - ${jobTitle}`;

      document.getElementById('invDetailSubtotal').textContent = formatMoney(inv.subtotal);
      document.getElementById('invDetailSubtotalFoot').textContent = formatMoney(inv.subtotal);
      document.getElementById('invDetailVat').textContent = formatMoney(inv.vatAmount);
      document.getElementById('invDetailTotal').textContent = formatMoney(inv.totalAmount);
      document.getElementById('invDetailPaid').textContent = formatMoney(inv.paidAmount);
      document.getElementById('invDetailRemaining').textContent = formatMoney(inv.remainingAmount);

      let badgeClass = 'badge-sent';
      if (inv.status === 'Paid') badgeClass = 'badge-paid';
      if (inv.status === 'Partial') badgeClass = 'badge-partial';
      if (inv.status === 'Overdue') badgeClass = 'badge-overdue';
      document.getElementById('invDetailStatusBadge').innerHTML = `<span class="status-badge ${badgeClass}">${inv.status}</span>`;

      new bootstrap.Modal(document.getElementById('modalInvoiceDetail')).show();
    }

    // ================= DEBT & AGING =================
    async function loadDebt() {
      const res = await fetch('/api/debt/overview');
      const data = await res.json();
      document.getElementById('debtAging1to30').textContent = formatMoney(data.summary.aging0to30);
      document.getElementById('debtAging31to60').textContent = formatMoney(data.summary.aging31to60);
      document.getElementById('debtAgingAbove60').textContent = formatMoney(data.summary.agingAbove60);

      const tbody = document.getElementById('debtTableBody');
      tbody.innerHTML = '';
      if (!data.debtList || data.debtList.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Hiện không có công nợ cần thu!</td></tr>';
        return;
      }
      data.debtList.forEach(item => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${item.invoiceCode}</strong></td>
            <td>${item.Client ? item.Client.companyName : '-'}</td>
            <td class="text-danger fw-bold">${formatMoney(item.remainingAmount)}</td>
            <td>${item.dueDate}</td>
            <td>
              <span class="badge ${item.overdueDays > 0 ? 'bg-danger' : 'bg-success'}">
                ${item.overdueDays > 0 ? item.overdueDays + ' ngày quá hạn' : 'Trong hạn'}
              </span>
            </td>
            <td><strong>${item.agingCategory}</strong></td>
            <td>
              <div class="d-flex gap-1">
                <button class="btn btn-sm btn-success" onclick="openRecordPayment(${item.id}, '${item.invoiceCode}', ${item.remainingAmount})">
                  <i class="fa-solid fa-hand-holding-dollar me-1"></i>Thu Tiền
                </button>
                <button class="btn btn-sm btn-outline-danger" onclick="sendDebtReminder(${item.id})">
                  <i class="fa-solid fa-bell me-1"></i>Nhắc Nợ
                </button>
              </div>
            </td>
          </tr>
        `;
      });
    }

    function openRecordPayment(invId, invCode, remaining) {
      document.getElementById('payInvoiceId').value = invId;
      document.getElementById('payInvoiceCode').value = invCode;
      document.getElementById('payRemainingText').value = formatMoney(remaining);
      document.getElementById('payAmount').value = remaining;
      document.getElementById('payAmount').max = remaining;
      new bootstrap.Modal(document.getElementById('modalRecordPayment')).show();
    }

    async function submitRecordPayment(e) {
      e.preventDefault();
      const body = {
        invoiceId: document.getElementById('payInvoiceId').value,
        amount: document.getElementById('payAmount').value,
        paymentMethod: document.getElementById('payMethod').value,
        referenceCode: document.getElementById('payRefCode').value,
        notes: document.getElementById('payNotes').value
      };

      const res = await fetch('/api/debt/payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('modalRecordPayment')).hide();
        alert('Ghi nhận thanh toán thành công!');
        loadDebt();
      } else {
        alert(data.message || 'Lỗi khi thu tiền!');
      }
    }

    async function sendDebtReminder(invoiceId) {
      const res = await fetch('/api/debt/remind', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ invoiceId })
      });
      const data = await res.json();
      alert(data.message || 'Đã gửi lời nhắc nợ thành công!');
    }

    // ================= AUDIT LOGS =================
    async function loadAudit() {
      const res = await fetch('/api/audit');
      const data = await res.json();
      const tbody = document.getElementById('auditTableBody');
      tbody.innerHTML = '';
      if (!data.logs || data.logs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Chưa có nhật ký nào.</td></tr>';
        return;
      }
      data.logs.forEach(l => {
        const time = new Date(l.createdAt).toLocaleTimeString('vi-VN') + ' ' + new Date(l.createdAt).toLocaleDateString('vi-VN');
        tbody.innerHTML += `
          <tr>
            <td class="text-muted"><small>${time}</small></td>
            <td><span class="badge bg-dark">${l.action}</span></td>
            <td><span class="badge bg-secondary">${l.module}</span></td>
            <td>${l.details}</td>
          </tr>
        `;
      });
    }

    // ================= EXPORT CSV HELPERS =================
    function exportClientsCSV() {
      if (!globalClients.length) return alert('Không có dữ liệu!');
      let csv = 'ID,Doanh Nghiệp,Mã Số Thuế,Địa Chỉ,Người Liên Hệ,Email,Điện Thoại,NetDays\n';
      globalClients.forEach(c => {
        csv += `"${c.id}","${c.companyName}","${c.taxCode}","${c.address || ''}","${c.contactPerson || ''}","${c.contactEmail || ''}","${c.contactPhone || ''}","${c.paymentTermDays}"\n`;
      });
      downloadCSV(csv, 'Danh_Sach_Khach_Hang_B2B.csv');
    }

    async function exportInvoicesCSV() {
      const res = await fetch('/api/invoices');
      const data = await res.json();
      let csv = 'Mã Hóa Đơn,Khách Hàng,Tổng Tiền,Đã Trả,Còn Nợ,Hạn Trả,Trạng Thái\n';
      (data.invoices || []).forEach(i => {
        csv += `"${i.invoiceCode}","${i.Client?.companyName || ''}","${i.totalAmount}","${i.paidAmount}","${i.remainingAmount}","${i.dueDate}","${i.status}"\n`;
      });
      downloadCSV(csv, 'Danh_Sach_Hoa_Don.csv');
    }

    async function exportDebtCSV() {
      const res = await fetch('/api/debt/overview');
      const data = await res.json();
      let csv = 'Mã Hóa Đơn,Khách Hàng,Số Tiền Nợ,Hạn Trả,Số Ngày Quá Hạn,Phân Loại Tuổi Nợ\n';
      (data.debtList || []).forEach(d => {
        csv += `"${d.invoiceCode}","${d.Client?.companyName || ''}","${d.remainingAmount}","${d.dueDate}","${d.overdueDays}","${d.agingCategory}"\n`;
      });
      downloadCSV(csv, 'Bao_Cao_Tuoi_No_Aging_Report.csv');
    }

    function downloadCSV(csv, filename) {
      const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }

    // ================= CLIENT PORTAL & ROLE SWITCHER LOGIC =================
    function switchUserRole(role, clientId = 1) {
      currentUserRole = role;
      currentClientId = clientId;

      const roleBadge = document.getElementById('roleBadge');
      const navRoleTitle = document.getElementById('navRoleTitle');
      const sidebarMenuInternal = document.getElementById('sidebarMenuInternal');
      const sidebarMenuClient = document.getElementById('sidebarMenuClient');
      const sidebarFooterInternal = document.getElementById('sidebarFooterInternal');
      const sidebarFooterClient = document.getElementById('sidebarFooterClient');
      const sidebarLogoIcon = document.getElementById('sidebarLogoIcon');
      const sidebarMainTitle = document.getElementById('sidebarMainTitle');
      const sidebarSubTitle = document.getElementById('sidebarSubTitle');

      if (role === 'client') {
        sidebarMenuInternal.style.display = 'none';
        sidebarMenuClient.style.display = 'block';
        sidebarFooterInternal.style.display = 'none';
        sidebarFooterClient.style.display = 'block';

        sidebarLogoIcon.innerHTML = '<i class="fa-solid fa-building"></i>';
        sidebarMainTitle.textContent = 'CỔNG KHÁCH HÀNG';

        roleBadge.className = 'badge bg-primary rounded-pill px-2 py-1';
        roleBadge.textContent = 'Khách hàng B2B';

        const clientNames = {
          1: 'FPT Software (Trần Thu Hà)',
          2: 'VNG Corporation (Nguyễn Hoàng Long)',
          3: 'Shopee Việt Nam (Lê Thùy Dương)'
        };
        const cName = clientNames[clientId] || 'Doanh Nghiệp Đối Tác';
        navRoleTitle.textContent = cName;
        sidebarSubTitle.textContent = cName.split('(')[0].trim();

        // Ẩn tất cả section nội bộ, hiện section client portal
        const sections = ['dashboard', 'clients', 'recruitment', 'invoices', 'debt', 'audit'];
        sections.forEach(s => {
          const el = document.getElementById('section-' + s);
          if (el) el.style.display = 'none';
        });
        document.getElementById('section-client-portal').style.display = 'block';
        document.getElementById('pageHeaderTitle').textContent = `Cổng Thông Tin Doanh Nghiệp - ${sidebarSubTitle.textContent}`;

        switchClientSubTab('invoices');
        loadClientPortal(clientId);
      } else {
        sidebarMenuInternal.style.display = 'block';
        sidebarMenuClient.style.display = 'none';
        sidebarFooterInternal.style.display = 'block';
        sidebarFooterClient.style.display = 'none';

        sidebarLogoIcon.innerHTML = '<i class="fa-solid fa-chart-pie"></i>';
        sidebarMainTitle.textContent = 'GODDY RECRUIT';
        sidebarSubTitle.textContent = 'Quản Lý Công Nợ B2B';

        document.getElementById('section-client-portal').style.display = 'none';

        if (role === 'admin') {
          roleBadge.className = 'badge bg-danger rounded-pill px-2 py-1';
          roleBadge.textContent = 'Admin';
          navRoleTitle.textContent = 'Huỳnh Nguyễn Vĩnh Phúc';
        } else if (role === 'accountant') {
          roleBadge.className = 'badge bg-success rounded-pill px-2 py-1';
          roleBadge.textContent = 'Kế toán';
          navRoleTitle.textContent = 'Phạm Sơn (Kế toán trưởng)';
        } else if (role === 'recruiter') {
          roleBadge.className = 'badge bg-warning text-dark rounded-pill px-2 py-1';
          roleBadge.textContent = 'Recruiter';
          navRoleTitle.textContent = 'Nguyễn Văn Minh (Senior)';
        }

        switchTab('dashboard');
      }
    }

    function switchClientSubTab(subTabKey) {
      const subTabs = ['invoices', 'jobs', 'placements', 'profile'];
      subTabs.forEach(t => {
        const tabEl = document.getElementById('clientSubTab' + t.charAt(0).toUpperCase() + t.slice(1));
        if (tabEl) tabEl.style.display = (t === subTabKey) ? 'block' : 'none';
      });

      // Update subnav buttons
      document.querySelectorAll('.client-subnav-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById('btnSubNav' + subTabKey.charAt(0).toUpperCase() + subTabKey.slice(1));
      if (activeBtn) activeBtn.classList.add('active');

      // Update sidebar items in client mode
      document.querySelectorAll('#sidebarMenuClient .sidebar-item').forEach(item => item.classList.remove('active'));
      const activeSidebar = Array.from(document.querySelectorAll('#sidebarMenuClient .sidebar-item')).find(el => el.getAttribute('onclick')?.includes(subTabKey));
      if (activeSidebar) activeSidebar.classList.add('active');
    }

    async function loadClientPortal(clientId) {
      try {
        const res = await fetch(`/api/clients/portal/${clientId}`);
        const data = await res.json();
        if (!data.success || !data.client) {
          alert('Không thể tải dữ liệu cổng khách hàng!');
          return;
        }

        const client = data.client;
        const summary = data.summary;

        // Hero info
        document.getElementById('cpCompanyName').textContent = client.companyName;
        document.getElementById('cpTaxCode').textContent = client.taxCode;
        document.getElementById('cpNetDays').textContent = `Net ${client.paymentTermDays} ngày`;
        document.getElementById('cpStatus').textContent = client.status;
        document.getElementById('cpContactPerson').textContent = client.contactPerson || '-';
        document.getElementById('cpContactEmail').textContent = client.contactEmail || '-';

        // 4 Metric cards
        document.getElementById('cpValRemaining').textContent = formatMoney(summary.totalRemaining);
        document.getElementById('cpValPaid').textContent = formatMoney(summary.totalPaid);
        document.getElementById('cpValActiveJobs').textContent = summary.activeJobs + ' Vị trí';
        document.getElementById('cpValWarranty').textContent = summary.warrantyActive + ' Ứng viên';

        // 1. Table Invoices
        const tbodyInv = document.getElementById('cpInvoicesTableBody');
        tbodyInv.innerHTML = '';
        if (!data.invoices || data.invoices.length === 0) {
          tbodyInv.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Công ty chưa có hóa đơn phát hành nào.</td></tr>';
        } else {
          data.invoices.forEach(inv => {
            let badgeClass = 'badge-sent';
            let statusText = 'Chờ thanh toán';
            if (inv.status === 'Paid') { badgeClass = 'badge-paid'; statusText = 'Đã thanh toán'; }
            else if (inv.status === 'Partial') { badgeClass = 'badge-partial'; statusText = 'Đã trả một phần'; }
            else if (inv.status === 'Overdue' || inv.overdueDays > 0) { badgeClass = 'badge-overdue'; statusText = `${inv.overdueDays} ngày quá hạn`; }

            tbodyInv.innerHTML += `
              <tr>
                <td><strong>${inv.invoiceCode}</strong></td>
                <td>${inv.issueDate}</td>
                <td>${inv.dueDate}</td>
                <td class="fw-bold">${formatMoney(inv.totalAmount)}</td>
                <td class="text-success">${formatMoney(inv.paidAmount)}</td>
                <td class="text-danger fw-bold">${formatMoney(inv.remainingAmount)}</td>
                <td><span class="status-badge ${badgeClass}">${statusText}</span></td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" onclick="viewInvoiceDetail(${inv.id})">
                    <i class="fa-solid fa-file-lines me-1"></i>Xem & In
                  </button>
                </td>
              </tr>
            `;
          });
        }

        // 2. Table Jobs
        const tbodyJobs = document.getElementById('cpJobsTableBody');
        tbodyJobs.innerHTML = '';
        if (!data.jobs || data.jobs.length === 0) {
          tbodyJobs.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">Chưa có vị trí tuyển dụng nào được đặt hàng.</td></tr>';
        } else {
          data.jobs.forEach(job => {
            const isOpen = job.status === 'Opening';
            tbodyJobs.innerHTML += `
              <tr>
                <td>#${job.id}</td>
                <td><strong class="text-primary">${job.title}</strong></td>
                <td>${job.department || 'Bộ phận Kỹ thuật'}</td>
                <td>${job.salaryRange}</td>
                <td>${job.feeRatePercent}%</td>
                <td>
                  <span class="badge ${isOpen ? 'bg-success' : 'bg-secondary'}">
                    ${isOpen ? 'Đang Tuyển (Opening)' : 'Đã Đóng (Closed)'}
                  </span>
                </td>
              </tr>
            `;
          });
        }

        // 3. Table Placements
        const tbodyPlacements = document.getElementById('cpPlacementsTableBody');
        tbodyPlacements.innerHTML = '';
        if (!data.placements || data.placements.length === 0) {
          tbodyPlacements.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Chưa có ứng viên nào onboard cho công ty.</td></tr>';
        } else {
          data.placements.forEach(p => {
            const isWarranty = p.status === 'UnderWarranty';
            tbodyPlacements.innerHTML += `
              <tr>
                <td><strong>${p.Candidate ? p.Candidate.fullName : 'Ứng viên'}</strong><div class="text-muted small">${p.Candidate?.email || ''}</div></td>
                <td>${p.Job ? p.Job.title : '-'}</td>
                <td class="fw-bold">${formatMoney(p.officialSalary)}</td>
                <td>${p.onboardDate}</td>
                <td><span class="badge bg-light text-dark border">${p.warrantyDays} ngày</span></td>
                <td>${p.warrantyEndDate || '-'}</td>
                <td>
                  <span class="badge ${isWarranty ? 'bg-warning text-dark' : 'bg-success'}">
                    <i class="fa-solid ${isWarranty ? 'fa-clock' : 'fa-check'} me-1"></i>
                    ${isWarranty ? 'Đang Bảo Hành' : 'Hoàn Thành'}
                  </span>
                </td>
              </tr>
            `;
          });
        }

        // 4. Profile
        document.getElementById('cpProfName').textContent = client.companyName;
        document.getElementById('cpProfTaxCode').textContent = client.taxCode;
        document.getElementById('cpProfAddress').textContent = client.address || 'Chưa cập nhật';
        document.getElementById('cpProfPerson').textContent = client.contactPerson || '-';
        document.getElementById('cpProfEmail').textContent = client.contactEmail || '-';
        document.getElementById('cpProfPhone').textContent = client.contactPhone || '-';
        document.getElementById('cpProfNetDays').textContent = `Net ${client.paymentTermDays} ngày kể từ ngày xuất HĐ VAT`;
        document.getElementById('cpProfStatus').textContent = `${client.status} (Hợp đồng nguyên tắc có hiệu lực)`;

      } catch (err) {
        console.error('Lỗi tải Cổng khách hàng:', err);
      }
    }

    function openClientRequestJobModal() {
      document.getElementById('formClientRequestJob').reset();
      new bootstrap.Modal(document.getElementById('modalClientRequestJob')).show();
    }

    async function submitClientRequestJob(e) {
      e.preventDefault();
      const body = {
        clientId: currentClientId,
        title: document.getElementById('cpJobTitle').value,
        department: document.getElementById('cpJobDepartment').value,
        salaryRange: document.getElementById('cpJobSalary').value || 'Thỏa thuận',
        feeRatePercent: 18.0
      };

      try {
        const res = await fetch('/api/recruitment/jobs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('modalClientRequestJob')).hide();
          alert('Gửi yêu cầu tuyển dụng mới thành công! GODDY Recruit đã tiếp nhận và sẽ sớm liên hệ.');
          loadClientPortal(currentClientId);
        } else {
          alert(data.message || 'Lỗi gửi yêu cầu!');
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ!');
      }
    }

    function openLoginModal() {
      new bootstrap.Modal(document.getElementById('modalLogin')).show();
    }

    function quickFillLogin(username, password) {
      document.getElementById('loginUsername').value = username;
      document.getElementById('loginPassword').value = password;
    }

    async function submitLogin(e) {
      e.preventDefault();
      const username = document.getElementById('loginUsername').value;
      const password = document.getElementById('loginPassword').value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('modalLogin')).hide();
          alert(`Đăng nhập thành công với vai trò: ${data.user.role.toUpperCase()}`);
          if (data.user.role === 'client') {
            switchUserRole('client', data.user.clientId || 1);
          } else {
            switchUserRole(data.user.role);
          }
        } else {
          alert(data.message || 'Đăng nhập thất bại!');
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ!');
      }
    }

    // Khởi tạo Dashboard hoặc Cổng Khách Hàng khi trang load xong
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const roleParam = urlParams.get('role');
      const clientParam = parseInt(urlParams.get('clientId')) || 1;

      if (roleParam === 'client') {
        switchUserRole('client', clientParam);
      } else if (roleParam === 'accountant' || roleParam === 'ketoan') {
        switchUserRole('accountant');
      } else if (roleParam === 'recruiter') {
        switchUserRole('recruiter');
      } else {
        loadDashboard();
      }
    });
  </script>
</body>
</html>
